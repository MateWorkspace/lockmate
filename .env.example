# Logger (slog is the only driver)
LOCKMATE_LOGGER_FORMAT=json
LOCKMATE_LOGGER_LEVEL=info
LOCKMATE_LOGGER_USE_TRACE=true

# Server ports
LOCKMATE_PORT_HTTP_SERVER=10701
LOCKMATE_PORT_GRPC_SERVER=10702

# HTTP lifecycle timeouts
LOCKMATE_HTTP_SERVER_READ_HEADER_TIMEOUT=5s
LOCKMATE_HTTP_SERVER_READ_TIMEOUT=15s
LOCKMATE_HTTP_SERVER_WRITE_TIMEOUT=30s
LOCKMATE_HTTP_SERVER_IDLE_TIMEOUT=60s
LOCKMATE_HTTP_SERVER_SHUTDOWN_TIMEOUT=10s

# PostgreSQL
LOCKMATE_POSTGRES_HOST=127.0.0.1
LOCKMATE_POSTGRES_PORT=5432
LOCKMATE_POSTGRES_USERNAME=postgres
LOCKMATE_POSTGRES_PASSWORD=postgres
LOCKMATE_POSTGRES_DATABASE=lockmate
LOCKMATE_POSTGRES_SSL_MODE=disable
LOCKMATE_POSTGRES_MAX_CONNECTIONS=20
LOCKMATE_POSTGRES_CONNECT_TIMEOUT=10s

# Session tokens: refresh tokens are HMAC JWTs; access tokens are ES256-signed
# by persisted, sealed signing keys (see the signing-key section).
# Durations accept Go notation (15m, 24h) or integer seconds, at least 1s.
LOCKMATE_TOKEN_REFRESH_SECRET=
LOCKMATE_TOKEN_ACCESS_DURATION=15m
LOCKMATE_TOKEN_REFRESH_DURATION=24h

# Signing keys: private halves are AES-256-GCM sealed with this 32-byte base64 key.
# Generate once with: openssl rand -base64 32
LOCKMATE_SIGNING_KEY_ENCRYPTION_KEY=
# Optional previous key, used only to re-seal existing keys during KEK rotation.
LOCKMATE_SIGNING_KEY_ENCRYPTION_KEY_PREVIOUS=
# Active key is rotated after this interval.
LOCKMATE_SIGNING_KEY_ROTATION_INTERVAL=720h
# Retiring keys stay verifiable for at least this long; must be >= access duration.
LOCKMATE_SIGNING_KEY_RETENTION_INTERVAL=1h
# How often the signing-key job runs to create/rotate keys, re-seal under a new
# encryption key, and retire old keys. Must not exceed the rotation interval.
LOCKMATE_SIGNING_KEY_RECONCILE_INTERVAL=1h

# Password
LOCKMATE_PASSWORD_BCRYPT_COST=10

# Fill missing bootstrap records from embedded database/seeder JSON.
LOCKMATE_SEEDER_ENABLED=true
# Required when seeding is enabled; no built-in credential defaults.
LOCKMATE_SEEDER_SUPER_PASSWORD=
LOCKMATE_SEEDER_ADMIN_PASSWORD=
LOCKMATE_SEEDER_USER_PASSWORD=
# Format: lockmate- followed by 64 lowercase hexadecimal characters.
LOCKMATE_SEEDER_CLIENT_SECRET_KEY=

# Public HTTPS origin; callback path is fixed.
LOCKMATE_HTTP_PUBLIC_URL=https://lockmate-dev.dhonan.my.id

# Caller IP resolution for client IP allowlists. The header is trusted only when
# the direct peer is a configured trusted proxy; otherwise the socket peer is used.
# Common choices: CF-Connecting-IP behind cloudflared/Cloudflare, or
# X-Forwarded-For behind nginx/Caddy.
LOCKMATE_CLIENT_IP_HEADER=CF-Connecting-IP
# Comma-separated proxy CIDRs (cloudflared, nginx, caddy). Empty trusts no proxy.
LOCKMATE_TRUSTED_PROXIES=

# Google sign-in (optional). Create a Google Web application OAuth client.
LOCKMATE_GOOGLE_OAUTH_ENABLED=false
LOCKMATE_GOOGLE_OAUTH_CLIENT_ID=
LOCKMATE_GOOGLE_OAUTH_CLIENT_SECRET=
LOCKMATE_GOOGLE_OAUTH_LAUNCH_DURATION=2m
LOCKMATE_GOOGLE_OAUTH_ATTEMPT_DURATION=10m
LOCKMATE_GOOGLE_OAUTH_HTTP_TIMEOUT=10s

# HTTP client callback URLs are opt-in; false requires HTTPS.
LOCKMATE_AUTH_REDIRECT_ALLOW_HTTP=false

# Generic authentication handoff and expired flow cleanup
LOCKMATE_AUTH_HANDOFF_DURATION=1m
LOCKMATE_AUTH_FLOW_CLEANUP_INTERVAL=5m

# Docker compose settings
DOCKER_COMPOSE_CONTAINER_NAME=lockmate-app
DOCKER_COMPOSE_HTTP_HOST_PORT=10701
DOCKER_COMPOSE_GRPC_HOST_PORT=10702
