Project lockmate {
    database_type: 'PostgreSQL'
    Note: '''
Intended space-aware schema for Lockmate. Users share one identity across projects;
roles, permissions, memberships, and application clients are scoped to a space.
This ERD guides the rewritten Go service; migrations and code will follow.
Partial indexes and PostgreSQL GIN operator classes are documented in index notes
for implementation in future SQL migrations.
References use individual IDs. Application validation must ensure that linked
roles, permissions, and memberships belong to the same space. Client authentication
identifies the calling application; user access still requires an eligible
membership and permissions in the client's space.
'''
}

Table spaces [headercolor: #059669] {
    Note: 'Project authorization boundary. Disabling or deleting a space blocks client authentication and membership access.'

    id          BIGINT      [pk, increment]
    slug        TEXT        [not null, note: 'Stable project identifier, such as taskmate or financemate.']
    name        TEXT        [not null]
    description TEXT        [not null, default: '']
    is_active   BOOLEAN     [not null, default: true]
    preferences JSONB       [not null, default: `'{}'::jsonb`]
    created_at  TIMESTAMPTZ [not null, default: `NOW()`]
    updated_at  TIMESTAMPTZ
    deleted_at  TIMESTAMPTZ
    created_by  BIGINT
    updated_by  BIGINT
    deleted_by  BIGINT

    Indexes {
        slug       [unique, name: 'uq_spaces_slug', note: 'Stable identifier; reserved even after soft deletion.']
        deleted_at [name: 'idx_spaces_deleted_at']
    }
}

Table permissions [headercolor: #7C3AED] {
    Note: 'Owned by one space. Slugs identify roles or permissions within that space; names are display labels.'

    id          BIGINT      [pk, increment]
    space_id    BIGINT      [not null]
    slug        TEXT        [not null, note: 'Stable identifier within the space.']
    name        TEXT        [not null, note: 'Human-readable display name.']
    description TEXT        [not null, default: '']
    preferences JSONB       [not null, default: `'{}'::jsonb`]
    created_at  TIMESTAMPTZ [not null, default: `NOW()`]
    updated_at  TIMESTAMPTZ
    deleted_at  TIMESTAMPTZ
    created_by  BIGINT
    updated_by  BIGINT
    deleted_by  BIGINT

    Indexes {
        space_id         [name: 'idx_permissions_space_id']
        (space_id, slug) [unique, name: 'uq_permissions_space_id_slug', note: 'Partial unique index: WHERE deleted_at IS NULL']
        name             [name: 'idx_permissions_name_trgm', note: 'PostgreSQL GIN index using gin_trgm_ops']
        deleted_at       [name: 'idx_permissions_deleted_at']
    }
}

Table roles [headercolor: #7C3AED] {
    Note: 'Owned by one space. Slugs identify roles or permissions within that space; names are display labels.'

    id          BIGINT      [pk, increment]
    space_id    BIGINT      [not null]
    slug        TEXT        [not null, note: 'Stable identifier within the space.']
    name        TEXT        [not null, note: 'Human-readable display name.']
    description TEXT        [not null, default: '']
    is_default  BOOLEAN     [not null, default: false]
    preferences JSONB       [not null, default: `'{}'::jsonb`]
    created_at  TIMESTAMPTZ [not null, default: `NOW()`]
    updated_at  TIMESTAMPTZ
    deleted_at  TIMESTAMPTZ
    created_by  BIGINT
    updated_by  BIGINT
    deleted_by  BIGINT

    Indexes {
        space_id         [name: 'idx_roles_space_id']
        (space_id, slug) [unique, name: 'uq_roles_space_id_slug', note: 'Partial unique index: WHERE deleted_at IS NULL']
        name             [name: 'idx_roles_name_trgm', note: 'PostgreSQL GIN index using gin_trgm_ops']
        space_id         [unique, name: 'uq_roles_space_id_default', note: 'Partial unique index: WHERE is_default = TRUE AND deleted_at IS NULL; at most one active default role per space.']
        deleted_at       [name: 'idx_roles_deleted_at']
    }
}

Table role_permission [headercolor: #A78BFA] {
    Note: 'Permissions granted by a role. Both endpoints must belong to the same space. Assignments are deleted physically.'

    id            BIGINT      [pk, increment]
    space_id      BIGINT      [not null]
    role_id       BIGINT      [not null]
    permission_id BIGINT      [not null]
    created_at    TIMESTAMPTZ [not null, default: `NOW()`]
    created_by    BIGINT

    Indexes {
        (space_id, role_id, permission_id) [unique, name: 'uq_role_permission_space_role_permission']
        role_id                            [name: 'idx_role_permission_role_id']
        permission_id                      [name: 'idx_role_permission_permission_id']
    }
}

Table users [headercolor: #2563EB] {
    Note: 'Global profiles shared across spaces. Classic and Google authentication are optional and can coexist; other authentication methods can reference this identity independently.'

    id          BIGINT      [pk, increment]
    name        TEXT        [not null]
    bio         TEXT        [not null, default: '']
    avatar_path TEXT        [note: 'Object-storage key for the shared profile avatar.']
    preferences JSONB       [not null, default: `'{}'::jsonb`]
    created_at  TIMESTAMPTZ [not null, default: `NOW()`]
    updated_at  TIMESTAMPTZ
    deleted_at  TIMESTAMPTZ
    created_by  BIGINT
    updated_by  BIGINT
    deleted_by  BIGINT

    Indexes {
        name       [name: 'idx_users_name_trgm', note: 'PostgreSQL GIN index using gin_trgm_ops']
        deleted_at [name: 'idx_users_deleted_at']
    }
}

Table classic_auths [headercolor: #3B82F6] {
    Note: 'Optional global username/password authentication. A user has at most one nondeleted record. Authentication requires both the credentials and user to be nondeleted. Changing or clearing email or phone resets its verification flag. Credentials are not deleted through cascading user deletion.'

    id                BIGINT      [pk, increment]
    user_id           BIGINT      [not null]
    username          TEXT        [not null]
    email             TEXT
    phone             TEXT
    password_hash     TEXT        [not null, note: 'Store only the password hash, never the raw password.']
    is_email_verified BOOLEAN     [not null, default: false]
    is_phone_verified BOOLEAN     [not null, default: false]
    preferences       JSONB       [not null, default: `'{}'::jsonb`]
    created_at        TIMESTAMPTZ [not null, default: `NOW()`]
    updated_at        TIMESTAMPTZ
    deleted_at        TIMESTAMPTZ
    created_by        BIGINT
    updated_by        BIGINT
    deleted_by        BIGINT

    Indexes {
        user_id           [unique, name: 'uq_classic_auths_user_id', note: 'Partial unique index: WHERE deleted_at IS NULL; zero or one nondeleted classic-auth record per user.']
        username          [unique, name: 'uq_classic_auths_username', note: 'Partial unique index: WHERE deleted_at IS NULL; globally unique among nondeleted credentials.']
        username          [name: 'idx_classic_auths_username_trgm', note: 'PostgreSQL GIN index using gin_trgm_ops']
        email             [unique, name: 'uq_classic_auths_email', note: 'Partial unique index: WHERE deleted_at IS NULL; nullable contacts allow multiple NULL values.']
        email             [name: 'idx_classic_auths_email_trgm', note: 'PostgreSQL GIN index using gin_trgm_ops']
        phone             [unique, name: 'uq_classic_auths_phone', note: 'Partial unique index: WHERE deleted_at IS NULL; nullable contacts allow multiple NULL values.']
        phone             [name: 'idx_classic_auths_phone_trgm', note: 'PostgreSQL GIN index using gin_trgm_ops']
        is_email_verified [name: 'idx_classic_auths_is_email_verified']
        is_phone_verified [name: 'idx_classic_auths_is_phone_verified']
        deleted_at        [name: 'idx_classic_auths_deleted_at']
    }
}

Table google_auths [headercolor: #60A5FA] {
    Note: 'Optional global Google sign-in identity. A user has at most one nondeleted Google account link, independent of classic credentials. Match accounts by the validated Google subject, never by email alone; linking to an existing user requires explicit account ownership verification. Authentication requires both the link and user to be nondeleted. Synchronize email and its verification flag from validated Google claims on sign-in without overwriting classic-auth contacts. Provider tokens are not persisted for sign-in.'

    id                BIGINT      [pk, increment]
    user_id           BIGINT      [not null]
    subject           TEXT        [not null, note: 'Google ID-token sub claim: stable account identifier; store as text and treat as immutable.']
    email             TEXT        [not null, note: 'Latest Google email from the requested email scope; may change and is not an account identifier.']
    is_email_verified BOOLEAN     [not null, default: false, note: 'Latest email_verified claim from Google.']
    preferences       JSONB       [not null, default: `'{}'::jsonb`]
    created_at        TIMESTAMPTZ [not null, default: `NOW()`]
    updated_at        TIMESTAMPTZ
    deleted_at        TIMESTAMPTZ
    created_by        BIGINT
    updated_by        BIGINT
    deleted_by        BIGINT

    Indexes {
        user_id    [unique, name: 'uq_google_auths_user_id', note: 'Partial unique index: WHERE deleted_at IS NULL; zero or one nondeleted Google account link per user.']
        subject    [unique, name: 'uq_google_auths_subject', note: 'Partial unique index: WHERE deleted_at IS NULL; a Google account can be linked to only one user at a time.']
        email      [name: 'idx_google_auths_email_trgm', note: 'PostgreSQL GIN index using gin_trgm_ops; email is searchable, not unique.']
        deleted_at [name: 'idx_google_auths_deleted_at']
    }
}

Table space_members [headercolor: #0891B2] {
    Note: 'Connects a global user to a space. Roles are assigned to this membership, never directly to the user. The space default role is assigned when joining.'

    id          BIGINT      [pk, increment]
    space_id    BIGINT      [not null]
    user_id     BIGINT      [not null]
    is_active   BOOLEAN     [not null, default: true, note: 'Suspension blocks access without deleting the global account.']
    preferences JSONB       [not null, default: `'{}'::jsonb`]
    created_at  TIMESTAMPTZ [not null, default: `NOW()`]
    updated_at  TIMESTAMPTZ
    deleted_at  TIMESTAMPTZ
    created_by  BIGINT
    updated_by  BIGINT
    deleted_by  BIGINT

    Indexes {
        (space_id, user_id) [unique, name: 'uq_space_members_space_id_user_id', note: 'Partial unique index: WHERE deleted_at IS NULL; suspended memberships still reserve their place.']
        user_id             [name: 'idx_space_members_user_id']
        deleted_at          [name: 'idx_space_members_deleted_at']
    }
}

Table space_member_role [headercolor: #22D3EE] {
    Note: 'A membership can receive multiple roles from its own space. Effective permissions are the union of the assigned roles. Assignments are deleted physically.'

    id              BIGINT      [pk, increment]
    space_id        BIGINT      [not null]
    space_member_id BIGINT      [not null]
    role_id         BIGINT      [not null]
    created_at      TIMESTAMPTZ [not null, default: `NOW()`]
    created_by      BIGINT

    Indexes {
        (space_id, space_member_id, role_id) [unique, name: 'uq_space_member_role_space_member_role']
        (space_id, role_id)                   [name: 'idx_space_member_role_space_id_role_id']
    }
}

Table clients [headercolor: #D97706] {
    Note: 'Consuming applications, each owned by one space. Authenticate using the stable slug and supplied secret. A client identifies the application and does not grant user roles or permissions. Disabled or deleted clients, or disabled or deleted parent spaces, cannot authenticate. One current secret is stored; rotation replaces its hash and redaction without secret history or overlapping secrets.'

    id                  BIGINT      [pk, increment]
    space_id            BIGINT      [not null]
    slug                TEXT        [not null, note: 'Immutable public client identifier, such as taskmate-web; globally unique and reserved after soft deletion.']
    name                TEXT        [not null, note: 'Display name; need not be unique.']
    description         TEXT        [not null, default: '']
    secret_key_hash     TEXT        [not null, note: 'Verify the supplied secret against this hash; never store the raw secret. Not a lookup identifier.']
    secret_key_redacted TEXT        [not null, note: 'Display only: show four leading and four trailing characters with the middle masked. Not a lookup identifier.']
    is_active           BOOLEAN     [not null, default: true]
    preferences         JSONB       [not null, default: `'{}'::jsonb`]
    created_at          TIMESTAMPTZ [not null, default: `NOW()`]
    updated_at          TIMESTAMPTZ
    deleted_at          TIMESTAMPTZ
    created_by          BIGINT
    updated_by          BIGINT
    deleted_by          BIGINT

    Indexes {
        slug       [unique, name: 'uq_clients_slug', note: 'Stable identifier; reserved even after soft deletion.']
        space_id   [name: 'idx_clients_space_id']
        name       [name: 'idx_clients_name_trgm', note: 'Partial PostgreSQL GIN index using gin_trgm_ops: WHERE deleted_at IS NULL']
        deleted_at [name: 'idx_clients_deleted_at']
    }
}

Table client_origins [headercolor: #D97706] {
    Note: 'A client may own many exact browser origins. Space ownership is derived through the client. The same origin may belong to several clients. CORS eligibility requires an active, nondeleted origin, client, and space; it does not authenticate a client or grant user permissions. Origin records are retained when their parent is soft-deleted.'

    id         BIGINT      [pk, increment]
    client_id  BIGINT      [not null]
    origin     TEXT        [not null, note: 'Canonical scheme://host[:port], at most 2048 bytes. HTTPS or local HTTP only; no paths, wildcards, null origins, or default ports.']
    is_active  BOOLEAN     [not null, default: true]
    created_at TIMESTAMPTZ [not null, default: `NOW()`]
    updated_at TIMESTAMPTZ
    deleted_at TIMESTAMPTZ
    created_by BIGINT
    updated_by BIGINT
    deleted_by BIGINT

    Indexes {
        (client_id, origin) [unique, name: 'uq_client_origins_client_id_origin', note: 'Partial: WHERE deleted_at IS NULL. Disabled records still reserve the origin; deleted records permit re-registration.']
        client_id           [name: 'idx_client_origins_client_id']
        origin              [name: 'idx_client_origins_origin', note: 'Partial: WHERE deleted_at IS NULL AND is_active = TRUE']
        deleted_at          [name: 'idx_client_origins_deleted_at']
    }
}

// Space ownership and global identity.
Ref: permissions.space_id > spaces.id
Ref: roles.space_id > spaces.id
Ref: space_members.space_id > spaces.id
Ref: space_members.user_id > users.id
Ref: classic_auths.user_id > users.id
Ref: google_auths.user_id > users.id
Ref: clients.space_id > spaces.id
Ref: client_origins.client_id > clients.id

// Role grants and membership assignments.
Ref: role_permission.space_id > spaces.id
Ref: role_permission.role_id > roles.id [delete: cascade]
Ref: role_permission.permission_id > permissions.id [delete: cascade]
Ref: space_member_role.space_id > spaces.id
Ref: space_member_role.space_member_id > space_members.id [delete: cascade]
Ref: space_member_role.role_id > roles.id [delete: cascade]

TableGroup identity [color: #2563EB] {
    users
    classic_auths
    google_auths
    Note: 'Shared profiles with optional classic and Google authentication across all Mate projects.'
}

TableGroup space_authorization [color: #7C3AED] {
    spaces
    roles
    permissions
    role_permission
    Note: 'Each space owns an independent role and permission catalog.'
}

TableGroup membership_access [color: #0891B2] {
    space_members
    space_member_role
    Note: 'Project memberships and their role assignments.'
}

TableGroup application_clients [color: #D97706] {
    clients
    client_origins
    Note: 'Space-owned consuming applications with hashed client secrets and per-client browser origin allowlists.'
}
